{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "flatbuffers",
      "camelcase": "Flatbuffers",
      "title": "FlatBuffers",
      "scope": "source.flatbuffers",
      "file-types": ["fbs"],
      "injection-regex": "^flatbuffers$",
      "class-name": "TreeSitterFlatbuffers",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "FlatBuffers grammar for tree-sitter",
    "authors": [
      {
        "name": "Stephen Panaro",
        "url": "https://github.com/smpanaro"
      }
    ],
    "links": {
      "repository": "https://github.com/smpanaro/tree-sitter-flatbuffers"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
